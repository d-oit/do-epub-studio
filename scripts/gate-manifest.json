{
  "$schema": "Gate parity manifest — defines expected checks for each entry point",
  "version": 1,
  "local": {
    "description": "Canonical local quality gate (./scripts/quality_gate.sh)",
    "checks": [
      "lint",
      "typecheck",
      "test:coverage",
      "build",
      "smoke",
      "design",
      "check-loc",
      "format:check",
      "coverage-parity"
    ]
  },
  "pr": {
    "description": "PR-gating checks (ci.yml + auxiliary workflows + external apps). Names are the exact `name:` values GitHub reports as check contexts, or the check name published by an external app (Codacy).",
    "checks": [
      "PR Gate (all paths)",
      "Full Quality Gate",
      "Pre-commit Hooks",
      "Fast Check (Changed Packages)",
      "Lint (Node ${{ matrix.node-version }})",
      "Typecheck (Node ${{ matrix.node-version }})",
      "Unit Tests (Node ${{ matrix.node-version }})",
      "Build (Node ${{ matrix.node-version }})",
      "Gate Visibility Sensor",
      "Setup & Diagnostics",
      "CodeQL Alert Check",
      "E2E Smoke Tests",
      "Gzipped bundle budget (ADR-107 §3)",
      "Lighthouse audit",
      "Worker Build Validation",
      "Codacy Static Code Analysis"
    ]
  },
  "release": {
    "description": "Required release readiness checks (release.yml)",
    "checks": [
      "Release Readiness Gate",
      "Verify tag matches VERSION file",
      "Verify tag is on main branch",
      "Coverage Gate",
      "Verify CI checks passed",
      "Cross-Browser E2E",
      "Performance Budgets",
      "Security Checks"
    ]
  }
}
