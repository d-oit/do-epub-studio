{
  "name": "do-epub-studio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:workflows",
    "lint:workflows": "bash scripts/validate-workflows.sh",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit --concurrency=1",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm test:e2e:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit",
    "check:agent-sync": "node scripts/check-agent-sync.mjs",
    "db:migrate:local": "pnpm --filter @do-epub-studio/worker exec wrangler d1 migrations apply do-epub-studio --local",
    "db:check": "pnpm --filter @do-epub-studio/worker exec wrangler d1 migrations list do-epub-studio --local",
    "verify:fast": "pnpm turbo run lint typecheck --affected && pnpm turbo run test:unit --filter=\"...[origin/main]\" --concurrency=1",
    "test:e2e:smoke": "PLAYWRIGHT_MODE=dev playwright test --grep @smoke",
    "bench": "pnpm --filter @do-epub-studio/reader-core bench",
    "build:analyze": "ANALYZE=true turbo run build",
    "bundle:budget": "pnpm --filter @do-epub-studio/web bundle:budget",
    "bundle:budget:enforce": "BUNDLE_BUDGET_FAIL_ON_VIOLATION=1 pnpm --filter @do-epub-studio/web bundle:budget:enforce",
    "knip": "knip",
    "check:dead-code": "scripts/dead-code-check.sh",
    "preflight:cloudflare": "node scripts/preflight-cloudflare.mjs",
    "check:epub-fixtures": "node scripts/check-epub-fixtures.mjs",
    "check:standards-status": "node scripts/check-standards-status.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "impeccable": "^4.9.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^31.0.0",
    "knip": "^6.44.2",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.2",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "4.1.12",
    "wrangler": "^4.162.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.5",
      "fast-uri": ">=4.2.3",
      "serialize-javascript": ">=7.0.3",
      "undici": ">=7.29.1",
      "zod": ">=4.6.6"
    }
  }
}
