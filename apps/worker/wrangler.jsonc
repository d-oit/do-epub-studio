{
  "name": "do-epub-studio-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  // @sentry/cloudflare (the worker's Sentry integration) imports node:async_hooks,
  // which requires the nodejs_compat compatibility flag. Without it, `wrangler deploy`
  // emits a pre-existing build warning and the SDK's async-context tracking can fail at
  // runtime. Keep this flag enabled for the sentry-required async primitives.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_BASE_URL": "https://do-epub-studio.example.com",
    "TURSO_DATABASE_URL": "file::memory:",
    "TURSO_AUTH_TOKEN": "",
    "SENTRY_DSN": "",
    "ENVIRONMENT": "development",
    "WEBAUTHN_RP_ID": "localhost",
    "WEBAUTHN_RP_NAME": "d.o.EPUB Studio",
    "WEBAUTHN_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "do-epub-studio",
      "database_id": "placeholder-replace-with-real-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS_BUCKET",
      "bucket_name": "do-epub-studio-books"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "placeholder-cache-kv-id"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiterDO"
      }
    ]
  },
  "send_email": [
    {
      "name": "EMAIL_SEND"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiterDO"]
    }
  ]
}
