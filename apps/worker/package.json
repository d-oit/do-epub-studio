{
  "name": "@do-epub-studio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:deploy-config": "wrangler deploy --config wrangler.jsonc --dry-run",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest --run",
    "test": "echo \"Use test:unit\"",
    "test:coverage": "pnpm test:unit --coverage"
  },
  "dependencies": {
    "@do-epub-studio/schema": "workspace:*",
    "@do-epub-studio/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@sentry/cloudflare": "^10.69.0",
    "@simplewebauthn/server": "^13.3.2",
    "argon2-wasm-edge": "^1.0.23",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@do-epub-studio/testkit": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.8.1",
    "jszip": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}
