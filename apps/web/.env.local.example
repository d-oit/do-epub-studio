VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_DEMO_LOGIN_ENABLED=1
VITE_DEMO_BOOK_SLUG=demo
# Published demo credentials (non-production only — the Worker fail-closes
# in production-like environments). These match what the demo seed script
# provisions with DEMO_READER_PASSWORD / DEMO_ADMIN_PASSWORD.
VITE_DEMO_READER_PASSWORD=demo-reader-password
VITE_DEMO_ADMIN_PASSWORD=demo-admin-password
# Optional: deployment-local LanguageTool server for spelling/grammar review
# (ADR-274). Start it with scripts/dev/languagetool.sh, then set:
# VITE_LANGUAGETOOL_URL=http://127.0.0.1:8081
VITE_HELP_URL=/help
