{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "model": "standard",
  "provider": {},
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
  },
  "mcp": {},
  "model_groups": {
    "lite": "cline-pass/cline-pass/mimo-v2.5",
    "standard": "cline-pass/cline-pass/mimo-v2.5",
    "ultra": "cline-pass/cline-pass/mimo-v2.5-pro"
  },
  "agent": {
    "build": { "model": "standard" },
    "explore": { "model": "lite" },
    "research": { "model": "ultra" },
    "design": { "model": "cline-pass/cline-pass/kimi-k3" },
    "reviewer": { "model": "ultra" },
    "vision": { "model": "lite" }
  }
}
