# Claude Code provider state. Only the project-shared settings file is
# tracked (it registers the repo's SessionStart hook); everything else in
# .claude/ stays ignored: settings.local.json (machine-local), skills/
# (symlinks into .agents/skills/), and worktrees/ (agent scratch trees).
#
# The pattern is `.claude/*` rather than `.claude/` on purpose: git cannot
# re-include a file whose parent *directory* is excluded, so a negation
# under a `.claude/` rule would never take effect.
.claude/*
!.claude/settings.json
!.claude/skills/

# Generated test corpus
packages/reader-core/src/__fixtures__/corpus/

# Local agent session artifacts (scratch reports, workdirs)
.session/
.do-harness/
.agents/events/
