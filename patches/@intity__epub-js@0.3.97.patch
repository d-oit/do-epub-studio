+/**
+ * pnpm patch (GOAP-228 close-out): the 0.3.97 npm tarball shipped without the
+ * `lib/` and `src/` builds its package.json `main`/`module` point to, so the
+ * package is un-importable. Restore a minimal ESM `lib/index.js` (the package
+ * is `"type":"module"`) that re-exports the shipped isomorphic CommonJS bundle
+ * (`dist/server/epub.cjs`) as the default. `import ePub` usage is unchanged.
+ */
+import epub from '../dist/server/epub.cjs';
+
+export default epub.ePub;
+export { epub as ePub };
