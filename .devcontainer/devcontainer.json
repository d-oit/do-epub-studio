{
  "name": "do-epub-studio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "none",
      "pnpmVersion": "10.13.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-typescript-next",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph"
      ]
    },
    "codespaces": {
      "customizations": {
        "permissions": {
          "contents": "write",
          "pull-requests": "write",
          "issues": "write"
        }
      }
    }
  },
  "postCreateCommand": "pnpm install --frozen-lockfile && npm install -g @opencode/cli"
}
